# SwasthyaSeva environment template
# Local dev: copy to backend/.env and fill in.
# Production: set these in YOUR Render service (backend) and Vercel projects (frontends).
# Never commit real values.

# Use "production" on Render; "development" locally.
NODE_ENV=production
PORT=5000

# --- Database: YOUR Supabase project ---
# Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_SERVICE_ROLE_KEY
# Project Settings -> Database -> Connection string (URI). Keep ?sslmode=require.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres?sslmode=require

# --- Auth and PII encryption ---
# Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_64_HEX_CHARS
# Must be at least 32 characters. Changing it makes existing encrypted PII unreadable.
PII_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARS

# First admin created by scripts/initFreshDb.js
ADMIN_USERNAME=CHANGE_ME_ADMIN_USERNAME
ADMIN_PASSWORD=CHANGE_ME_min_12_chars

# --- Cloudflare Turnstile: YOUR account ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- OTP delivery: YOUR MSG91 account ---
# MSG91 Dashboard -> Authkey
MSG91_AUTH_KEY=
# SMS OTP flow template. Body must contain variables ##name##, ##otp##, ##detail##.
# Example: "Dear ##name##, your SwasthyaSeva OTP is ##otp##. ##detail##"
MSG91_SMS_TEMPLATE_ID=
# Email OTP (sender domain must be verified in MSG91)
MSG91_EMAIL_DOMAIN=
MSG91_EMAIL_SENDER=
MSG91_EMAIL_SENDER_NAME=
MSG91_EMAIL_OTP_TEMPLATE_ID=
MSG91_EMAIL_REG_TEMPLATE_ID=
MSG91_EMAIL_RECEPTIONIST_TEMPLATE_ID=

# Optional TextBee SMS gateway (leave blank when using MSG91)
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=

# Optional email fallbacks (leave blank when using MSG91)
FROM_EMAIL=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
AWS_REGION=

# --- Images: YOUR Cloudinary account ---
# Dashboard -> API Keys: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# --- Maps: YOUR Google Cloud key (restrict to your domains) ---
GOOGLE_MAP_API_KEY=

# --- Browser origins (backend CORS) ---
# Must list every frontend origin that calls the API.
ALLOWED_ORIGINS=https://swasthyaseva.online,https://admin.swasthyaseva.online,https://doctor.swasthyaseva.online,https://clinic.swasthyaseva.online

# Development only. Refused when NODE_ENV=production or RENDER=true.
DEV_MODE=false
# Skip MSG91/TextBee entirely and force OTP 123456 (logged to the backend console).
# Refused when NODE_ENV=production or RENDER=true.
OTP_BYPASS=false
# Numbers that receive a fixed 123456 OTP and skip SMS. Ignored in production.
# DEBUG_NUMBERS=+91XXXXXXXXXX

# =====================================================================
# Vercel (frontends) — set these per project, not in the backend
# =====================================================================
# Project "web":
#   NEXT_PUBLIC_API_URL=https://YOUR-BACKEND.onrender.com/api/public
#   NEXT_PUBLIC_PATIENT_API_URL=https://YOUR-BACKEND.onrender.com/api/patient
# Project "admin":
#   NEXT_PUBLIC_API_URL=https://YOUR-BACKEND.onrender.com/api/admin
# Project "doctor":
#   NEXT_PUBLIC_API_URL=https://YOUR-BACKEND.onrender.com/api/doctor
# Project "clinic":
#   NEXT_PUBLIC_API_URL=https://YOUR-BACKEND.onrender.com/api/clinic
# All four projects:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY
#   NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_KEY

# --- Deliberately unset ---
# AXIOM_TOKEN and AXIOM_*_DATASET belonged to the previous developer's Axiom
# account. Leave them unset so no request/response metadata leaves your servers.
