# SwasthyaSeva environment template
# Copy to backend/.env for local development.
# In production, set these in YOUR hosting provider (e.g. Render).
# Never commit real values.

NODE_ENV=development
PORT=5000

# --- Database (your own Supabase project or any Postgres) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_SERVICE_ROLE_KEY
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# --- Auth and PII encryption ---
# Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_64_HEX_CHARS
# Must be at least 32 characters. Changing it makes existing encrypted PII unreadable.
PII_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARS

# --- Cloudflare Turnstile (create a new site in your own account) ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- OTP delivery (configure the provider you own) ---
# TextBee (SMS)
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
# MSG91 (email and SMS)
MSG91_AUTH_KEY=
MSG91_SMS_TEMPLATE_ID=
MSG91_EMAIL_DOMAIN=
MSG91_EMAIL_SENDER=
MSG91_EMAIL_SENDER_NAME=
MSG91_EMAIL_OTP_TEMPLATE_ID=
MSG91_EMAIL_REG_TEMPLATE_ID=
MSG91_EMAIL_RECEPTIONIST_TEMPLATE_ID=

# --- Images ---
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# --- Maps ---
GOOGLE_MAP_API_KEY=

# --- Frontend variables (set these in Vercel, not in the backend) ---
# NEXT_PUBLIC_API_URL=https://YOUR-BACKEND/api/admin
# NEXT_PUBLIC_PATIENT_API_URL=https://YOUR-BACKEND/api/patient
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Optional ---
# Comma-separated list of allowed browser origins. Defaults to swasthyaseva.online + localhost.
ALLOWED_ORIGINS=https://YOUR-DOMAIN,https://admin.YOUR-DOMAIN,https://doctor.YOUR-DOMAIN,https://clinic.YOUR-DOMAIN

# Development only. Refused when NODE_ENV=production or RENDER=true.
DEV_MODE=false
# Numbers that receive a fixed 123456 OTP and skip SMS. Ignored in production.
# DEBUG_NUMBERS=+91XXXXXXXXXX

# --- Deliberately unset ---
# AXIOM_TOKEN and AXIOM_*_DATASET belonged to the previous developer's Axiom
# account. Leave them unset so no request/response metadata leaves your servers.
# Only set them after creating your own Axiom account.
# AXIOM_TOKEN=
